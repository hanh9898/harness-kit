#!/usr/bin/env python3
"""kit: retrieve individual building blocks without loading the entire store.

  kit list              groups with names (groups.csv) and piece counts
  kit list <group>      one line per piece (ID, rung, name, summary)
  kit show <id|name>    every column of exactly one piece
  kit list P            one line per team architecture pattern (patterns.md)
  kit show P<number>    every column of exactly one pattern, for example P6
  kit list delegation   historical four axes/seven levels; current authority: kit show authority-design-and-calibration
  kit show axis<number> one axis (1 to 4); kit show step<number> one level (1 to 7)
  kit show combine      the "How the axes combine" section of delegation.md
  kit list rules        gate rules (gates.csv, gate=yes), one line per rule: ID, topic, check
  kit list rules <topic>  all rules for a topic (gate rules marked *); `kit list rules all` lists topics
  kit show <rule ID>    all columns of a rule (for example 4.06), with its verified quote when it is a gate rule

Add --dir DIR to use another kit directory; default: the kit containing scripts/.
For patterns and delegation references, show exits 3 if the entry is absent.
Uses only the standard library.
"""
import argparse
import csv
import re
import shlex
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from piece_ids import PieceAliases
sys.path.pop(0)


MARKDOWN_ENTRY_NOT_FOUND = 3


def load(kit_dir):
    with (kit_dir / "legos.csv").open(encoding="utf-8", newline="") as f:
        reader = csv.DictReader(f)
        return [(reader.line_num, row) for row in reader]


def load_groups(kit_dir):
    """{group ID: name} from groups.csv."""
    with (kit_dir / "groups.csv").open(encoding="utf-8", newline="") as f:
        return {(r["id"] or "").strip(): r["name"] for r in csv.DictReader(f)}


def optional_markdown_lines(path):
    try:
        return path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return []
    except (OSError, UnicodeError) as exc:
        raise ValueError(f"Cannot read {path}: {exc}") from exc


def load_patterns(kit_dir):
    """Table rows in patterns.md as {number: [cells...]}; empty if the file is absent."""
    head, out = [], {}
    for line in optional_markdown_lines(kit_dir / "patterns.md"):
        if not line.startswith("|"):
            continue
        line = line.rstrip()
        # Consume escape pairs before matching column separators.
        pipes = [m.start() for m in re.finditer(r"\\.|\|", line) if m[0] == "|"]
        if pipes[-1] != len(line) - 1:
            pipes.append(len(line))
        cells = [line[start + 1:end].strip() for start, end in zip(pipes, pipes[1:])]
        if not cells:
            continue
        if cells[0] == "#":
            head = cells
        elif cells[0].isdecimal():
            out[int(cells[0])] = cells
    return out, head


def load_delegation(kit_dir):
    """Axis and level rows plus the combination section from delegation.md: (axes, steps, combine)."""
    axes, steps, combine, heads = {}, {}, [], {}
    in_combine = False
    for line in optional_markdown_lines(kit_dir / "delegation.md"):
        if line.startswith("## "):
            in_combine = line.startswith("## How the axes combine")
            continue
        if in_combine and line.strip():
            combine.append(line)
        cells = [c.strip() for c in line.strip().strip("|").split(" | ")]
        if line.startswith("| #"):
            heads["axis"] = cells
        elif line.startswith("| Step"):
            heads["step"] = cells
        elif line.startswith("| ") and cells[0].isdigit():
            (axes if "axis" in heads and "step" not in heads else steps)[int(cells[0])] = cells
    return axes, steps, combine, heads


def load_rules(kit_dir):
    """(rules, gates): rules.csv by ID; gates maps IDs to gate=yes rows."""
    def read(name):
        path = kit_dir / name
        if not path.is_file():
            return []
        with path.open(encoding="utf-8", newline="") as f:
            return list(csv.DictReader(f))
    return read("rules.csv"), {r["id"]: r for r in read("gates.csv") if r.get("gate") == "yes"}


def fail(msg, code=2):
    print(f"ERROR: {msg}", file=sys.stderr)
    return code


def catalog_command(dir_override, *args):
    command = ["kit"]
    if dir_override is not None:
        command.extend(("--dir", str(Path(dir_override).absolute())))
    return shlex.join([*command, *args])


def cmd_list_rules(rules, gates, topic, dir_override=None):
    if not rules:
        return fail("rules.csv is missing from the kit directory.")
    if topic is None:
        for r in rules:
            if r["id"] in gates:
                print(f"{r['id']}\t{r['topic']}\t{r['check']}\t{r['rule']}")
        print("Next step: kit show <id> to see one rule; kit list rules <topic> to see a topic.")
        return 0
    if topic.lower() == "all":
        for t, n in sorted(Counter(r["topic"] for r in rules).items()):
            print(f"{t}\t{n} rules")
        return 0
    picked = [r for r in rules if r["topic"].lower() == topic.lower()]
    if not picked:
        command = catalog_command(dir_override, "list", "rules", "all")
        return fail(f"Topic `{topic}` does not exist.\nNext step: run `{command}` to see topics.")
    for r in picked:
        print(f"{r['id']}{'*' if r['id'] in gates else ''}\t{r['check']}\t{r['rule']}")
    return 0


LEGACY_NOTICE = ("Historical partial delegation material; current recommended authority: "
                 "kit show authority-design-and-calibration (kit/authority/DESIGN.md). Reconcile selected legacy rules "
                 "under prior adoption authority before replacement.")


def cmd_list(rows, group, patterns=None, deleg=None, rules=None, topic=None, names=None, *, dir_override=None):
    if group is not None and group.lower() == "rules":
        return cmd_list_rules(*(rules or ([], {})), topic, dir_override)
    if group is not None and group.lower() == "delegation":
        axes, steps = (deleg or ({}, {}, [], {}))[:2]
        if not axes:
            return fail("delegation.md is missing from the kit directory.")
        print(LEGACY_NOTICE)
        for n, c in axes.items():
            print(f"axis{n}\t{c[1]}\t{c[2]}")
        for n, c in steps.items():
            print(f"step{n}\t{c[1]}\t{c[2]}")
        return 0
    if group is not None and group.lower() in ("p", "patterns"):
        if not patterns:
            return fail("patterns.md is missing from the kit directory.")
        for n, c in patterns.items():
            name = c[1] if len(c) > 1 else ""
            summary = c[3] if len(c) > 3 else ""
            print(f"P{n}\t{name}\t{summary}")
        return 0
    if group is None:
        for g, n in sorted(Counter(r["group"] for r in rows).items()):
            print(f"{g}\t{(names or {}).get(g, '')}\t{n} pieces")
        if patterns:
            print(f"P\tTeam patterns\t{len(patterns)} team architecture patterns")
        print("Next step: kit list <group> to see pieces, kit show <id> to see one piece.")
        return 0
    picked = [r for r in rows if r["group"].lower() == group.lower()]
    if not picked:
        command = catalog_command(dir_override, "list")
        return fail(f"Group `{group}` does not exist.\nNext step: run `{command}` to see groups.")
    for r in picked:
        print(f"{r['id']}\t{r['rung']}\t{r['name']}\t{r['summary']}")
    return 0


def cmd_show(rows, query, patterns, head, deleg, rules, aliases):
    q = query.strip().lower()
    axes, steps, combine, heads = deleg or ({}, {}, [], {})
    if q == "combine":
        if not combine:
            return fail(f"`{query}` does not match.\nNext step: run `kit list delegation` to inspect delegation references.",
                        code=MARKDOWN_ENTRY_NOT_FOUND)
        print(LEGACY_NOTICE)
        print("\n".join(combine))
        return 0
    for kind, table in (("axis", axes), ("step", steps)):
        if q.startswith(kind) and q[len(kind):].isdigit():
            n = int(q[len(kind):])
            if n not in table:
                return fail(f"`{query}` does not match.\nNext step: run `kit list delegation` to see axes and levels.",
                            code=MARKDOWN_ENTRY_NOT_FOUND)
            print(LEGACY_NOTICE)
            for k, v in zip(heads[kind], table[n]):
                print(f"{k}: {v}")
            return 0
    if q[:1] == "p" and q[1:].isdigit():
        n = int(q[1:])
        if n not in (patterns or {}):
            return fail(f"`{query}` matches no pattern.\nNext step: run `kit list P` to see patterns.",
                        code=MARKDOWN_ENTRY_NOT_FOUND)
        for k, v in zip(head, patterns[n]):
            print(f"{k}: {v}")
        return 0
    if rules and re.fullmatch(r"\d+\.\d+", q):
        hit = [r for r in rules[0] if r["id"] == q]
        if not hit:
            return fail(f"`{query}` matches no rule.\nNext step: run `kit list rules` to see gate rules.")
        for k, v in hit[0].items():
            print(f"{k}: {v}")
        g = rules[1].get(q)
        if g:
            print(f"gate: yes ({g['verify_method']})\nverified_quote: {g['verified_quote']}\ngate_note: {g['note']}")
        return 0
    identity = aliases.canonical(q)
    hit = [r for r in rows if q and (r["id"].lower() == identity or r["name"].lower() == q)]
    if len(hit) != 1:
        why = "matches no piece" if not hit else "matches more than one piece"
        return fail(f"`{query}` {why}.\nNext step: run `kit list` then `kit list <group>` to find the correct ID.")
    for k, v in hit[0].items():
        print(f"{k}: {v}")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dir")
    sub = ap.add_subparsers(dest="cmd", required=True)
    lp = sub.add_parser("list")
    lp.add_argument("group", nargs="?")
    lp.add_argument("topic", nargs="?")
    sub.add_parser("show").add_argument("query")
    a = ap.parse_args(argv)
    dir_override = a.dir
    if dir_override is None:
        a.dir = str(Path(__file__).resolve().parent.parent)
    try:
        entries, names = load(Path(a.dir)), load_groups(Path(a.dir))
    except OSError as e:
        return fail(f"Cannot read legos.csv or groups.csv in {a.dir} ({e}).")
    try:
        patterns, head = load_patterns(Path(a.dir))
        deleg = load_delegation(Path(a.dir))
    except ValueError as e:
        return fail(e)
    try:
        rules = load_rules(Path(a.dir))
        aliases = PieceAliases.load(Path(a.dir), entries, (row["id"] for row in rules[0]))
    except (OSError, ValueError) as e:
        return fail(e)
    rows = [row for _, row in entries]
    if a.cmd == "list":
        return cmd_list(rows, a.group, patterns, deleg, rules, a.topic, names, dir_override=dir_override)
    return cmd_show(rows, a.query, patterns, head, deleg, rules, aliases)


if __name__ == "__main__":
    sys.exit(main())
